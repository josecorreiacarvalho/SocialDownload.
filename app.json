{
  "expo": {
    "name": "Social\nDownload",
    "slug": "SocialDownload",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/socialdownload-icon.png",
    "scheme": "socialdownload",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.jcorreiacarvalho.socialdownload",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/socialdownload-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/socialdownload-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/socialdownload-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-font",
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/plain"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}